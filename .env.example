# Copy this file to .env and fill in your own keys.
#   cp .env.example .env
#
# Then load them into the macOS Keychain, which is where the app actually
# reads them from:
#   ./scripts/load-keys.sh
#
# .env is gitignored. Keys never leave your machine except to the two APIs.

# https://www.assemblyai.com/app/account
MSNOTES_ASSEMBLYAI_KEY=

# https://console.anthropic.com/settings/keys
MSNOTES_ANTHROPIC_KEY=
